# Auto normalize line endings for all files
* text=auto

# Python files
*.py text eol=lf
*.pyc text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.csv text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Git files
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.mp4 binary
*.avi binary
*.mov binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pt binary
*.weights binary
